# ============================================================================
# Streamlit secrets 配置模板
# ----------------------------------------------------------------------------
# 使用方法：
#   1. 本地 / 自建服务器：复制本文件为 `.streamlit/secrets.toml`（去掉 .example）；
#   2. Streamlit Community Cloud：应用页 → Settings → Secrets，粘贴下面的 TOML；
#   3. 环境变量兜底：设置 `DEEPSEEK_API_KEY=sk-...`（也支持通用名 `API_KEY`）。
#
# ⚠️ `secrets.toml` 已加入 .gitignore，请勿把真实密钥提交到仓库或截图外发。
# ⚠️ 密钥只会在服务端读取，不会通过 st.markdown / 页面组件下发到浏览器。
# ============================================================================

[api]
# 默认服务；本应用的 AI 顾问固定读取 deepseek，可保留此项便于以后扩展。
provider = "deepseek"

[api.deepseek]
# 在 https://platform.deepseek.com/api_keys 申请
api_key = "sk-your-deepseek-api-key"
base_url = "https://api.deepseek.com/v1"
# 2026 当前模型：deepseek-flash（也可用 deepseek-v4-pro）
# 旧版 API 账号如仍使用旧模型名，可改为 "deepseek-chat" 或 "deepseek-reasoner"
model = "deepseek-flash"
# 单次请求超时（秒）；深度思考模式会自动提升到至少 90 秒
timeout = 30.0
# 设为 false 可临时关闭该服务（保留密钥但不允许调用）
enabled = true

# 其它服务示例（按需取消注释）：
# [api.openai]
# api_key = "sk-your-openai-api-key"
# base_url = "https://api.openai.com/v1"
# model = "gpt-4o-mini"
#
# [api.dashscope]
# api_key = "sk-your-dashscope-api-key"
# base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# model = "qwen-plus"
