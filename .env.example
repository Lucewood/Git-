# 应用运行配置示例：复制为 .env 后按需修改
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 调试模式
APP_DEBUG=false

# 地图渲染方式: components（推荐） | iframe
MAP_RENDER_MODE=components

# 城市对比工具最多可选城市数
MAX_COMPARISON_CITIES=8

# 地图组件高度（px）
DEFAULT_MAP_HEIGHT=520

# seaborn 回归重采样次数（越小渲染越快）
N_BOOT_REGRESSION=100

# 就业推荐默认展示条数 / 最多可展示条数
CAREER_TOP_N=10
MAX_CAREER_RESULTS=30

# 爬虫策略：同域请求最小间隔（秒）/ 单次请求超时（秒）
CRAWL_DELAY=1.0
CRAWL_TIMEOUT=10.0

# DeepSeek API（优先使用 Streamlit secrets；本地开发 / CI 可用环境变量兜底）
# 也支持通用名 API_KEY，但服务专属名优先。
DEEPSEEK_API_KEY=
# 可选：覆盖接入点 / 模型 / 超时（默认 https://api.deepseek.com/v1 + deepseek-flash）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT=30
# 默认服务（省略时读取 secrets[api].provider，再回退 openai）
API_PROVIDER=deepseek
